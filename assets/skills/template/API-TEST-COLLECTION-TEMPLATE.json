{
  "info": {
    "name": "{Project Name (Chinese)} API Test v{Current Version}",
    "description": "Automatically generated by impm-task-coding-writetest based on the API test cases of the current task; conforms to the Postman Collection v2.1 specification, can be executed by API-TEST-RUNNER.py for API testing, and can also be imported directly into Apifox for debugging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "{API Path} - {Case Name} ({Case ID})",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/example?id=1",
          "host": ["{{base_url}}"],
          "path": ["api", "example"],
          "query": [
            { "key": "id", "value": "1" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"key\":\"value\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('business code code=0', function () { pm.expect(pm.response.json().code).to.eql(0); });"
            ]
          }
        }
      ],
      "expected": {
        "status": 200,
        "max_response_time": 2000,
        "headers": [
          { "name": "Content-Type", "contains": "application/json" }
        ],
        "assertions": [
          { "type": "json", "path": "$.code", "equals": 0 },
          { "type": "json", "path": "$.data.id", "contains": "expected substring" },
          { "type": "body_contains", "value": "expected text to appear" }
        ]
      }
    }
  ]
}
